# ─── SERVER ────────────────────────────────────────────────────
PORT=8000

# ─── MONGODB ───────────────────────────────────────────────────
# Get your URI from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random

# ─── CORS (Production) ─────────────────────────────────────────
# Set this to your deployed Vercel frontend URL
# Example: https://inkwell-notes.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
